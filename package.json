{
    "name": "finx",
    "version": "0.1.0",
    "description": "Learning-focused Financial AI Agent with MCP servers for market data",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:market-data": "pnpm --filter @finx/mcp-market-data dev",
        "build:market-data": "pnpm --filter @finx/mcp-market-data build",
        "build": "pnpm --recursive build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "tsx test-market-data.ts",
        "lint": "pnpm --recursive lint",
        "clean": "pnpm --recursive exec rm -rf dist node_modules",
        "install:all": "pnpm install"
    },
    "keywords": [
        "finance",
        "investment",
        "mcp",
        "market-data",
        "learning",
        "monorepo"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^24.10.0",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "@typescript-eslint/parser": "^8.46.3",
        "@vitest/coverage-v8": "^4.0.8",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.1",
        "globals": "^16.5.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3",
        "vitest": "^4.0.8"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@9.0.0"
}