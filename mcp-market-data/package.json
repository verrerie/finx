    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "@vitest/coverage-v8": "^4.0.8",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^4.0.8"
    },
    "engines": {
        "node": ">=22.0.0"
